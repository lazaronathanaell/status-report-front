# Variável principal da bateria: troque o modelo a cada execução.
OLLAMA_MODEL=gemma3:4b
OLLAMA_VERSION=0.12.10
OLLAMA_MODEL_VOLUME=ollama-pipeline-benchmark-models

# "original" envia ao Ollama o mesmo payload lógico da aplicação.
# "controlled" adiciona JSON/temperatura/seed para comparação determinística.
GENERATION_MODE=original
DIPLOMA_PREPROCESS_MODE=original
TEMPERATURE=0
SEED=42
NUM_CTX=8192
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=0

# Limites de CPU e RAM impostos pelo Docker.
OLLAMA_CPU_LIMIT=4.0
OLLAMA_RAM_LIMIT=8G
RUNNER_CPU_LIMIT=2.0
RUNNER_RAM_LIMIT=3G
MONITOR_CPU_LIMIT=0.25
MONITOR_RAM_LIMIT=256M

# GPU. O overhead é memória reservada ao sistema, não um hard cap de VRAM.
GPU_DEVICE_ID=0
GPU_VRAM_RESERVE_BYTES=1073741824

SAMPLE_INTERVAL_SECONDS=1
MAX_FILES=0
PROCESS_ID=22001149961202519
INPUT_DIR=./data/22001149961202519/pdfs
REFERENCE_DIR=./data/22001149961202519/ground_truth
CASE_PROFILE_HOST=./data/22001149961202519/profile.json
REQUEST_TIMEOUT_SECONDS=900
NAME_SIMILARITY_THRESHOLD=0.80
TEXT_SIMILARITY_THRESHOLD=0.80
