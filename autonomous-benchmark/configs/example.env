OLLAMA_MODEL=gemma3:4b
OLLAMA_VERSION=0.12.10
OLLAMA_MODEL_VOLUME=ollama-pipeline-benchmark-models
GENERATION_MODE=original
DIPLOMA_PREPROCESS_MODE=original

OLLAMA_CPU_LIMIT=4.0
OLLAMA_RAM_LIMIT=8G
RUNNER_CPU_LIMIT=2.0
RUNNER_RAM_LIMIT=3G
GPU_DEVICE_ID=0
GPU_VRAM_RESERVE_BYTES=1073741824

OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=0

SAMPLE_INTERVAL_SECONDS=1
MAX_FILES=0
PROCESS_ID=SEU_PROCESSO
INPUT_DIR=./data/SEU_PROCESSO/pdfs
REFERENCE_DIR=./data/SEU_PROCESSO/ground_truth
CASE_PROFILE_HOST=./data/SEU_PROCESSO/profile.json
REQUEST_TIMEOUT_SECONDS=900
NAME_SIMILARITY_THRESHOLD=0.80
TEXT_SIMILARITY_THRESHOLD=0.80
